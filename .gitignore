# OS/editor noise
.DS_Store
.idea/
.vscode/
*.swp

# Go build/test output
bin/
build/bin/
dist/
coverage.out
*.test

# Frontend dependencies/build metadata
frontend/node_modules/
frontend/package.json.md5

# Python environments and caches
.venv/
venv/
analyzer/.venv/
__pycache__/
*.py[cod]

# PyInstaller output from freezing the analyzer. Release CI writes the frozen
# bundle into internal/analyzerbin/assets/analyzer.zip, which stays a small
# committed placeholder in development builds.
analyzer-dist/
analyzer-build/

# Generated local project output
projects/*.json
!projects/demo.json

# Local audio samples can be large or copyrighted. Keep explicit demo assets trackable.
samples/*
!samples/.gitkeep
!samples/demo.*
